# ==============================================================
# IoT Smart Water Tank Monitoring System - Environment Config
# ==============================================================

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=water_tank_db
DB_USER=root
DB_PASS=

# Security & API Authentication
# The ESP32 must provide this API key in the X-API-Key header or api_key JSON field
API_KEY=smarttank_secret_key_2026

# Tank Hardware Calibration Defaults
DEFAULT_TANK_HEIGHT_CM=100.0
DEFAULT_TANK_CAPACITY_LITERS=1000.0

# Water Level Thresholds (%)
DEFAULT_HIGH_THRESHOLD=70.0
DEFAULT_MEDIUM_THRESHOLD=30.0
DEFAULT_LOW_THRESHOLD=30.0
DEFAULT_CRITICAL_THRESHOLD=15.0

# Analog Water Level Sensor Calibration Defaults (ADC: 0 - 4095)
DEFAULT_SENSOR_MIN_RAW=500
DEFAULT_SENSOR_MAX_RAW=2800

# Device Watchdog Settings (Seconds)
# If no reading received within OFFLINE_TIMEOUT_SECONDS, device marked OFFLINE
OFFLINE_TIMEOUT_SECONDS=30
